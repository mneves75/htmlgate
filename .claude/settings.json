{
  "permissions": {
    "deny": [
      "Bash(git add -f*)",
      "Bash(git add --force*)",
      "Bash(git rm*packages/cli/LICENSE*)"
    ],
    "ask": [
      "Bash(pnpm run site:deploy --live*)",
      "Bash(node scripts/site-deploy.mjs --live*)",
      "Bash(pnpm run setup --config .instance/production.json*)",
      "Edit(docs/perf/budgets.json)",
      "Write(docs/perf/budgets.json)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -x \"$HOME/.claude/hooks/claude-gate\" ] || \"$HOME/.claude/hooks/claude-gate\" baseline"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -x \"$HOME/.claude/hooks/claude-gate\" ] || \"$HOME/.claude/hooks/claude-gate\" stop -- 'pnpm run check'",
            "timeout": 900
          }
        ]
      }
    ]
  }
}
