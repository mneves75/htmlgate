// Local development and tests. An Instance's real config is generated by `pnpm run setup`
// into the git-ignored .instance/wrangler.jsonc; nothing account-specific belongs here.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "htmlgate-dev",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-29",
  "workers_dev": false,
  "preview_urls": false,
  "d1_databases": [
    { "binding": "DB", "database_name": "htmlgate-dev", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }
  ],
  "r2_buckets": [
    { "binding": "BODIES", "bucket_name": "htmlgate-dev-bodies" }
  ],
  "ratelimits": [
    { "name": "WRITE_LIMIT", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } }
  ],
  // Hourly cleanup of expired Shares; locally it runs only when a test asks for it (/__scheduled).
  "triggers": { "crons": ["17 * * * *"] },
  "observability": { "enabled": true }
}
